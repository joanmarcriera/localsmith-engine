{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Implementation plan",
  "type": "object",
  "required": ["project", "tasks"],
  "additionalProperties": false,
  "properties": {
    "project":   {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "decisions": {"type": "string", "maxLength": 2000},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["path", "intent"],
        "additionalProperties": false,
        "properties": {
          "path":   {"type": "string", "pattern": "^[A-Za-z0-9._-][A-Za-z0-9._/-]*$"},
          "intent": {"type": "string", "minLength": 1, "maxLength": 1000},
          "deps":   {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
