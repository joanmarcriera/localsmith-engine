# AI workflow — copy to .env, fill in, then: chmod 600 .env
# Bash-export syntax (also works with `set -a; source .env; set +a`)
# bin/orchestrate.sh loads this file before dispatching workflow stages.

# Z.AI Coding Lite — Anthropic-compatible endpoint
export ZAI_API_KEY=replace_me
export ZAI_MODEL=glm-4.6
export ZAI_MAX_TOKENS=4096

# Remote Ollama on the LAN box (8GB VRAM)
export OLLAMA_HOST=http://192.168.0.5:30068
export OLLAMA_MODEL=qwen2.5-coder:14b
export OLLAMA_SCAFFOLD_MODEL=qwen2.5-coder:7b
export OLLAMA_REVIEW_MODEL=qwen2.5-coder:14b
export OLLAMA_FAST_MODEL=qwen3:4b
export OLLAMA_SMALL_MODEL=phi3:mini
export OLLAMA_REASONING_MODEL=deepseek-r1:8b
export OLLAMA_EMBED_MODEL=nomic-embed-text:latest
export OLLAMA_RERANK_MODEL=jina-reranker-v3-BF16:latest

# Local SearXNG on the same LAN box. Used by bin/search and the dashboard /tools page.
export SEARXNG_HOST=http://192.168.0.5:30053

# Brave Search API — fallback when SearXNG is unreachable or returns no results.
# Free tier: 2000 req/month. Get a key at https://api.search.brave.com/app/keys.
# Used by `bin/search --backend brave` and `bin/search --backend auto`.
export BRAVE_API_SEARCH=replace_me

# LM Studio on Mac M5 (OpenAI-compat). Adjust model id to what `lms ls` shows.
# The dispatcher also accepts LM_STUDIO_HOST / LM_STUDIO_MODEL aliases.
export LMSTUDIO_HOST=http://localhost:1234
export LMSTUDIO_MODEL=google/gemma-4-31b
# Optional role-specific LM Studio overrides. Leave commented unless you load
# separate models for planning/implementation/review.
# export LMSTUDIO_PLAN_MODEL=google/gemma-4-31b
# export LMSTUDIO_IMPLEMENT_MODEL=google/gemma-4-31b
# export LMSTUDIO_REVIEW_MODEL=google/gemma-4-31b

# Provider routing. Defaults are scaffold=ollama, plan=claude, implement=zai,
# review=ollama. Use lmstudio here to route a stage to Gemma through LM Studio.
# export SCAFFOLD_PROVIDER=ollama
# export PLAN_PROVIDER=claude
# export IMPL_PROVIDER=zai
# export REVIEW_PROVIDER=lmstudio

# Verification strictness. Package install/build checks are on by default for
# package.json projects. Docker build is opt-in because it is slower and mutates
# the local Docker cache.
export VERIFY_PACKAGE_INSTALL=1
export VERIFY_PACKAGE_BUILD=1
export VERIFY_MODEL_REVIEW=1
# export VERIFY_DOCKER_BUILD=1

# Where bin/ai appends call records
export LOG_FILE=logs/tokens.jsonl
