<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Unattended queue drainer for AI workflow.

  Install:
    cp launchd/com.marc.ai-workflow.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.marc.ai-workflow.plist

  Tail logs:
    tail -f "/Users/marc/Development/Project/localsmith-engine/logs/launchd.out" \
            "/Users/marc/Development/Project/localsmith-engine/logs/launchd.err"

  Pause / resume / remove:
    launchctl kickstart -k gui/$(id -u)/com.marc.ai-workflow            # force run now
    launchctl bootout   gui/$(id -u)/com.marc.ai-workflow               # remove

  Behaviour:
    - Every 30 minutes, runs orchestrate.sh against every queue/*.md file.
    - orchestrate.sh + verify.sh are idempotent: completed steps are skipped,
      failed steps preserve state for the next tick.
    - Files in queue/ stay in queue/ — the state machine inside projects/<slug>/
      tracks progress, not the queue file's location.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marc.ai-workflow</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "/Users/marc/Development/Project/localsmith-engine" &amp;&amp; shopt -s nullglob &amp;&amp; bin/orchestrate.sh queue/*.md</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/marc/Development/Project/localsmith-engine</string>

    <key>StartInterval</key>
    <integer>1800</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/marc/Development/Project/localsmith-engine/logs/launchd.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/marc/Development/Project/localsmith-engine/logs/launchd.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
